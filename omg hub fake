-- 1. CẤU HÌNH HỆ THỐNG & TỰ ĐỘNG XÁC THỰC KEY (KHÓA 1 THIẾT BỊ - HWID)
--------------------------------------------------------------------------------
local CONFIG = {
    TITLE       = "OMG Hub | Blox Fruits",
    FIREBASE_DB = "https://vd12-c514c-default-rtdb.asia-southeast1.firebasedatabase.app/keys/",
    KEY_FILE    = "VanDatDev_SavedKey.txt"
}

local getHwid = gethwid or get_hwid or (syn and syn.get_hwid) or function() 
    return game:GetService("RbxAnalyticsService"):GetClientId() 
end
local clientHWID = getHwid()

local httpRequest = (syn and syn.request) or (http and http.request) or http_request or request

local function verifyKey(userKey)
    if not userKey or userKey == "" or not httpRequest then return false, "Lỗi kết nối!" end
    userKey = string.gsub(userKey, "%s+", "")
    local requestUrl = CONFIG.FIREBASE_DB .. userKey .. ".json"
    
    local success, response = pcall(function()
        return httpRequest({ Url = requestUrl, Method = "GET", Headers = { ["Content-Type"] = "application/json" } })
    end)

    if not success or not response or response.Body == "null" or response.Body == "" then
        return false, "Key không hợp lệ!"
    end

    local decodeSuccess, keyData = pcall(function() return HttpService:JSONDecode(response.Body) end)
    if not decodeSuccess or not keyData then return false, "Dữ liệu lỗi!" end

    if keyData.expires_at and os.time() > keyData.expires_at then
        return false, "Key đã hết hạn!"
    end

    if keyData.hwid == nil or keyData.hwid == "" then
        pcall(function()
            httpRequest({
                Url = requestUrl, Method = "PATCH",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode({ hwid = clientHWID })
            })
        end)
    elseif keyData.hwid ~= clientHWID then
        return false, "Key đã đăng ký thiết bị khác!"
    end

    return true, "Thành công!"
end

-- Kiểm tra Key lưu sẵn
local savedKey = ""
if readfile and isfile and isfile(CONFIG.KEY_FILE) then
    pcall(function() savedKey = readfile(CONFIG.KEY_FILE) end)
end

local isKeyValid, _ = verifyKey(savedKey)
if not isKeyValid then
    warn("[OMG Hub] Chưa xác thực Key hoặc Key không hợp lệ! Vui lòng kích hoạt qua Key System.")
    -- Vẫn cho phép tải UI nếu chạy test độc lập
end

