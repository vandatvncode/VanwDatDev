-- Thread Auto Farm Level & Quái
task.spawn(function()
    while task.wait(0.1) do
        if _G.AutoFarmLevel then
            pcall(function()
                EquipWeapon()
                for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                    if enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
                        repeat task.wait()
                            if not _G.AutoFarmLevel then break end
                            LocalPlayer.Character.HumanoidRootPart.CFrame = enemy.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
                            VirtualUser:CaptureController()
                            VirtualUser:ClickButton1(Vector2.new(500, 500))
                        until not enemy or not enemy:FindFirstChild("Humanoid") or enemy.Humanoid.Health <= 0
                    end
                end
            end)
        end
    end
end)

-- Thread Auto Nhặt Rương (Tween)
task.spawn(function()
    while task.wait(0.5) do
        if _G.AutoChest then
            pcall(function()
                for _, v in pairs(workspace:GetDescendants()) do
                    if string.find(v.Name, "Chest") and (v:IsA("Part") or v:IsA("MeshPart")) then
                        if not _G.AutoChest then break end
                        TweenTo(v.CFrame, 300)
                        task.wait(0.5)
                    end
                end
            end)
        end
    end
end)

