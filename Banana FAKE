--------------------------------------------------------------------------------
-- HÀM XÁC THỰC FIREBASE & LƯU KEY
--------------------------------------------------------------------------------
local httpRequest = (syn and syn.request) or (http and http.request) or http_request or request

local function verifyKey(userKey)
    if not userKey or userKey == "" then
        return false, "Vui lòng nhập Key!"
    end

    userKey = string.gsub(userKey, "%s+", "")

    if not httpRequest then
        return false, "Executor không hỗ trợ HTTP Request!"
    end

    local requestUrl = CONFIG.FIREBASE_DB .. userKey .. ".json"
    
    local success, response = pcall(function()
        return httpRequest({
            Url = requestUrl,
            Method = "GET",
            Headers = {
                ["Content-Type"] = "application/json"
            }
        })
    end)

    if not success or not response then
        return false, "Không thể kết nối đến Firebase!"
    end

    if response.Body == "null" or response.Body == "" then
        return false, "Key không tồn tại hoặc không hợp lệ!"
    end

    local decodeSuccess, keyData = pcall(function()
        return HttpService:JSONDecode(response.Body)
    end)

    if not decodeSuccess or not keyData then
        return false, "Dữ liệu phản hồi bị lỗi!"
    end

    local currentTime = os.time()
    if keyData.expires_at and currentTime > keyData.expires_at then
        return false, "Key của bạn đã hết hạn!"
    end

    -- Lưu Key hợp lệ vào bộ nhớ máy/device
    if writefile then
        pcall(function()
            writefile(CONFIG.KEY_FILE, userKey)
        end)
    end

    return true, "Xác thực thành công!"
end

--------------------------------------------------------------------------------
-- KÍCH HOẠT XETER HUB V4 (Đã sửa lỗi Remotes)
--------------------------------------------------------------------------------
local function loadMainHub()
    print("[VanDat Dev] Key hợp lệ! Đang chờ game tải dữ liệu...")
    
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = CONFIG.TITLE,
        Text = "Kích hoạt thành công! Đang tải Xeter Hub...",
        Duration = 5
    })

    -- Sửa lỗi 'Remotes is not a valid member': Bắt buộc chờ Remotes load xong
    pcall(function()
        ReplicatedStorage:WaitForChild("Remotes", 15)
    end)

    -- Cấu hình và chạy Xeter Hub
    getgenv().Version = "V4"
    getgenv().Team = "Marines"

    task.spawn(function()
        local scriptSuccess, err = pcall(function()
            loadstring(game:HttpGet("https://raw.githubusercontent.com/TlDinhKhoi/Xeter/refs/heads/main/Main.lua"))()
        end)

        if not scriptSuccess then
            warn("[VanDat Dev] Lỗi khi tải Xeter Hub:", err)
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Lỗi Tải Script",
                Text = "Xeter Hub lỗi! Vui lòng thử lại sau.",
                Duration = 5
            })
        end
    end)
end

--------------------------------------------------------------------------------
-- BƯỚC KIỂM TRA AUTOLOGIN (TỰ ĐỘNG BỎ QUA GUI NẾU KEY CÓ SẴN & HỢP LỆ)
--------------------------------------------------------------------------------
local savedKey = ""
if readfile and isfile and isfile(CONFIG.KEY_FILE) then
    pcall(function()
        savedKey = readfile(CONFIG.KEY_FILE)
    end)
end

if savedKey ~= "" then
    print("[VanDat Dev] Tìm thấy Key đã lưu. Đang tự động kiểm tra...")
    local isValid, _ = verifyKey(savedKey)
    if isValid then
        loadMainHub()
        return -- Kết thúc script tại đây, không hiện GUI
    else
        -- Key hết hạn hoặc sai -> Xóa file lưu cũ
        if delfile then pcall(function() delfile(CONFIG.KEY_FILE) end) end
        print("[VanDat Dev] Key đã lưu hết hạn hoặc không hợp lệ. Đang bật bảng nhập Key...")
    end
end

